# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0e0c0c"

# Main text color
theme[main_fg]="#d4d0cc"

# Title color for boxes
theme[title]="#c42b2b"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#e04545"

# Background color of selected item in processes box
theme[selected_bg]="#4a4646"

# Foreground color of selected item in processes box
theme[selected_fg]="#e8e4e0"

# Color of inactive/disabled text
theme[inactive_fg]="#4a4646"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#c42b2b"

# Box outline and divider line color
theme[cpu_box]="#913333"
theme[mem_box]="#913333"
theme[net_box]="#913333"
theme[proc_box]="#913333"
theme[div_line]="#4a4646"

# Gradient for all meters and graphs
theme[temp_start]="#8a7d6b"
theme[temp_mid]="#c42b2b"
theme[temp_end]="#e04545"

theme[cpu_start]="#6b7266"
theme[cpu_mid]="#c42b2b"
theme[cpu_end]="#e04545"

theme[free_start]="#6b7266"
theme[free_mid]="#8a7d6b"
theme[free_end]="#a89880"

theme[cached_start]="#5a5858"
theme[cached_mid]="#787575"
theme[cached_end]="#999696"

theme[available_start]="#6b7266"
theme[available_mid]="#8a9183"
theme[available_end]="#8a9183"

theme[used_start]="#913333"
theme[used_mid]="#c42b2b"
theme[used_end]="#e04545"

theme[download_start]="#5a5858"
theme[download_mid]="#913333"
theme[download_end]="#c42b2b"

theme[upload_start]="#5a5858"
theme[upload_mid]="#913333"
theme[upload_end]="#c42b2b"
